{
  "name": "mnemo",
  "version": "2.5.7",
  "description": "Long-term memory layer for Claude Code sessions \u2014 persists context across sessions, learns from corrections, enforces lessons at tool-use time.",
  "author": {
    "name": "George Pagaremos",
    "email": "gremos@users.noreply.github.com"
  },
  "commands": [
    "./memload.md",
    "./memsave.md",
    "./wiki-save.md",
    "./wiki-compile.md",
    "./wiki-init.md"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/load-context.py"
            ],
            "timeout": 5,
            "statusMessage": "Loading Mnemo context..."
          },
          {
            "type": "command",
            "command": "/usr/bin/python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/wiki-map.py"
            ],
            "timeout": 5,
            "statusMessage": "Loading wiki map..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/guard-action.py"
            ]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/track-correction.py"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/wiki-topic.py"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/wrap-session.sh"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
